---
import Button from "./Button.astro";
---

<main>
    <section class="intro reveal" aria-label="Resumen de la boda">
        <p>Guadalupe, Cáceres</p>
        <strong>Sábado 19 de septiembre</strong>
        <p>2026 · Fecha provisional</p>
    </section>

    <section id="ubicacion" class="places" aria-label="Ubicaciones">
        <article class="place reveal">
            <figure class="place__image">
                <img src="/parroquia.webp" alt="Real Monasterio de Nuestra Señora de Guadalupe" loading="lazy" />
            </figure>
            <div class="place__body">
                <p class="kicker">Ceremonia</p>
                <h2>Real Monasterio de Nuestra Señora de Guadalupe</h2>
                <p>Plaza Sta. María de Guadalupe<br />10140 Guadalupe, Cáceres</p>
                <Button url="https://maps.app.goo.gl/X1X32SgFZemfSFDx8" text="Cómo llegar" />
            </div>
        </article>

        <article class="place reveal">
            <figure class="place__image">
                <img src="/banquete.webp" alt="Vista aérea del Cortijo de Gorbea" loading="lazy" />
            </figure>
            <div class="place__body">
                <p class="kicker">Celebración</p>
                <h2>Cortijo de Gorbea</h2>
                <p>Carretera EX 116, km 4,800<br />06760 Navalvillar de Pela, Badajoz</p>
                <Button url="https://maps.app.goo.gl/eQwNPLijpexz96Hs7" text="Cómo llegar" />
            </div>
        </article>
    </section>

    <section id="rsvp" class="statement reveal">
        <p class="kicker">Confirmación</p>
        <h2>¿Nos acompañas?</h2>
        <p>
            Nos encantará contar contigo. Próximamente compartiremos el formulario
            para confirmar asistencia y comunicar cualquier alergia o intolerancia.
        </p>
        <Button url="https://forms.gle/ER6xNFeWJFc3uii59" text="Confirmar asistencia" />
    </section>

    <section id="lista" class="gift reveal">
        <div>
            <p class="kicker">Lista de bodas</p>
            <h2>Celebrarlo juntos es lo importante</h2>
        </div>
        <div>
            <p>
                Lo que más nos apetece es compartir este día con vosotros. Para
                quienes queráis acompañarnos también en el comienzo de esta nueva
                etapa, os dejamos nuestro número de cuenta.
            </p>
            <div class="iban">
                <span>IBAN</span>
                <strong class="no-autolink">ES58 0128 8700 1301 0061 3981</strong>
                <small>Concepto: “Boda Casilda y Rodrigo”</small>
            </div>
        </div>
    </section>
</main>

<script>
    const revealEls = document.querySelectorAll(".reveal");
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("revealed");
                    observer.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.08, rootMargin: "0px 0px -30px 0px" }
    );

    revealEls.forEach((el) => observer.observe(el));
</script>

<style>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    main {
        background: #f4f6f0;
        color: #293d34;
        padding: clamp(42px, 6vw, 74px) clamp(18px, 5vw, 72px) 76px;
    }

    .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }

    .intro,
    .places,
    .statement,
    .gift {
        width: min(100%, 1040px);
        margin-inline: auto;
    }

    .intro {
        margin-bottom: clamp(58px, 8vw, 92px);
        padding: 22px 0 26px;
        border-top: 1px solid rgba(52, 78, 66, 0.15);
        border-bottom: 1px solid rgba(52, 78, 66, 0.15);
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: baseline;
        gap: 22px;
        text-align: center;
    }

    .intro p,
    .kicker,
    .iban span,
    .iban small {
        font-family: "Montserrat", sans-serif;
    }

    .intro p {
        margin: 0;
        color: rgba(52, 78, 66, 0.6);
        font-size: 0.64rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .intro strong {
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(2rem, 4vw, 3.25rem);
        font-weight: 400;
        line-height: 1;
        letter-spacing: 0;
    }

    .places {
        margin-bottom: clamp(62px, 9vw, 106px);
    }

    .place {
        display: grid;
        grid-template-columns: minmax(250px, 0.56fr) minmax(0, 1fr);
        gap: clamp(28px, 5vw, 70px);
        align-items: center;
        padding: clamp(30px, 4vw, 48px) 0;
        border-top: 1px solid rgba(52, 78, 66, 0.14);
    }

    .place:last-child {
        border-bottom: 1px solid rgba(52, 78, 66, 0.14);
    }

    .place__image {
        margin: 0;
        aspect-ratio: 1.34;
        overflow: hidden;
        background: #e4eadf;
    }

    .place__image img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        filter: saturate(0.8) contrast(0.96);
        transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .place:hover .place__image img {
        transform: scale(1.025);
    }

    .kicker {
        margin: 0 0 9px;
        color: #708275;
        font-size: 0.63rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    h2 {
        margin: 0;
        color: #293d34;
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(2rem, 4.2vw, 3.6rem);
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1.04;
    }

    .place__body p:not(.kicker),
    .statement > p:not(.kicker),
    .gift p {
        color: rgba(41, 61, 52, 0.68);
        font-family: "Montserrat", sans-serif;
        font-size: 0.86rem;
        font-weight: 300;
        line-height: 1.82;
    }

    .place__body p:not(.kicker) {
        margin: 19px 0 23px;
    }

    .statement {
        max-width: 690px;
        margin-bottom: clamp(62px, 9vw, 106px);
        padding: clamp(28px, 4vw, 42px) 0;
        text-align: center;
        border-top: 1px solid rgba(52, 78, 66, 0.15);
        border-bottom: 1px solid rgba(52, 78, 66, 0.15);
    }

    .statement > p:not(.kicker) {
        max-width: 570px;
        margin: 18px auto 24px;
    }

    .gift {
        display: grid;
        grid-template-columns: minmax(240px, 0.82fr) minmax(0, 1fr);
        gap: clamp(28px, 6vw, 76px);
    }

    .gift p {
        margin: 0 0 22px;
    }

    .iban {
        display: grid;
        gap: 8px;
        padding-top: 18px;
        border-top: 1px solid rgba(52, 78, 66, 0.15);
    }

    .iban span,
    .iban small {
        color: rgba(52, 78, 66, 0.58);
        font-size: 0.61rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .iban strong {
        color: #293d34;
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(1.35rem, 2.8vw, 2.15rem);
        font-weight: 400;
        overflow-wrap: anywhere;
    }

    @media (max-width: 760px) {
        main {
            padding: 34px 18px 58px;
        }

        .intro,
        .place,
        .gift {
            grid-template-columns: 1fr;
        }

        .intro {
            gap: 8px;
            text-align: left;
        }

        .place {
            gap: 22px;
        }

        .place__image {
            aspect-ratio: 1.42;
        }

        .statement {
            text-align: left;
        }

        .statement > p:not(.kicker) {
            margin-left: 0;
            margin-right: 0;
        }
    }
</style>
