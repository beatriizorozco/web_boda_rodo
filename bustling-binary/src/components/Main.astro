---
import Button from "./Button.astro";
---

<main>
    <section class="intro reveal" aria-label="Resumen de la boda">
        <p>Guadalupe, Cáceres</p>
        <strong>Sábado 19 de septiembre</strong>
    </section>

    <section id="ubicacion" class="places" aria-label="Ubicaciones">
        <article class="place reveal">
            <figure class="place__image">
                <img src="/parroquia.webp" alt="Real Monasterio de Nuestra Señora de Guadalupe" loading="lazy" />
            </figure>
            <div class="place__body">
                <p class="kicker">Ceremonia</p>
                <h2>Real Monasterio de Nuestra Señora de Guadalupe</h2>
                <p>Plaza Sta. María de Guadalupe<br />10140 Guadalupe, Cáceres</p>
                <Button url="https://maps.app.goo.gl/X1X32SgFZemfSFDx8" text="Cómo llegar" />
            </div>
        </article>

        <article class="place reveal place--reverse">
            <figure class="place__image">
                <img src="/banquete.webp" alt="Vista aérea del Cortijo de Gorbea" loading="lazy" />
            </figure>
            <div class="place__body">
                <p class="kicker">Celebración</p>
                <h2>Cortijo de Gorbea</h2>
                <p>Carretera EX 116, km 4,800<br />06760 Navalvillar de Pela, Badajoz</p>
                <Button url="https://maps.app.goo.gl/eQwNPLijpexz96Hs7" text="Cómo llegar" />
            </div>
        </article>
    </section>

    <section id="rsvp" class="statement reveal">
        <p class="kicker">Confirmación</p>
        <h2>¿Nos acompañas?</h2>
        <p>
            Nos encantará contar contigo. Puedes confirmar tu asistencia y
            comunicarnos cualquier alergia o intolerancia en el formulario.
        </p>
        <Button url="https://docs.google.com/forms/d/e/1FAIpQLSd3WrbNaQY9xYywGCddYKZ4MBE9CgRPWT4boddcgYc9bDvisQ/viewform?usp=publish-editor" text="Confirmar asistencia" />
    </section>

    <section id="lista" class="gift reveal">
        <div>
            <p class="kicker">Lista de bodas</p>
            <h2>Celebrarlo juntos es lo importante</h2>
        </div>
        <div>
            <p>
                Lo que más nos apetece es compartir este día con vosotros. Para
                quienes queráis acompañarnos también en el comienzo de esta nueva
                etapa, os dejamos nuestro número de cuenta.
            </p>
            <div class="iban">
                <span>IBAN</span>
                <strong class="no-autolink">ES58 0128 8700 1301 0061 3981</strong>
                <small>Concepto: “Boda Casilda y Rodrigo”</small>
            </div>
        </div>
    </section>
</main>

<script>
    const revealEls = document.querySelectorAll(".reveal");
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("revealed");
                    observer.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.08, rootMargin: "0px 0px -30px 0px" }
    );

    revealEls.forEach((el) => observer.observe(el));
</script>

<style>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    main {
        background: var(--page-bg);
        color: var(--ink);
        padding: 46px 18px 74px;
    }

    .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }

    .intro,
    .places,
    .statement,
    .gift {
        width: min(100%, 1080px);
        margin-inline: auto;
    }

    .intro {
        display: grid;
        gap: 10px;
        margin-bottom: 58px;
        padding: 28px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        text-align: center;
    }

    .intro p,
    .kicker,
    .iban span,
    .iban small {
        font-family: var(--font-body);
    }

    .intro p,
    .kicker,
    .iban span,
    .iban small {
        margin: 0;
        color: rgba(47, 51, 45, 0.52);
        font-size: 0.62rem;
        font-weight: 300;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .intro strong {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: clamp(2.25rem, 11vw, 3.45rem);
        font-weight: 300;
        line-height: 0.98;
    }

    .places {
        display: grid;
        gap: 54px;
        margin-bottom: 68px;
    }

    .place {
        display: grid;
        gap: 24px;
    }

    .place__image {
        width: min(82%, 330px);
        margin: 0;
        overflow: hidden;
        border-radius: 10px;
        background: var(--wash);
    }

    .place:nth-child(2) .place__image {
        justify-self: end;
    }

    .place__image img {
        width: 100%;
        aspect-ratio: 0.82;
        display: block;
        object-fit: cover;
        filter: saturate(0.82) contrast(0.96) brightness(1.01);
        transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .place:hover .place__image img {
        transform: scale(1.025);
    }

    .place__body {
        display: grid;
        gap: 14px;
        padding-bottom: 32px;
        border-bottom: 1px solid var(--line);
    }

    .kicker {
        color: var(--sage);
    }

    h2 {
        margin: 0;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: clamp(2.25rem, 11vw, 3.75rem);
        font-weight: 300;
        letter-spacing: 0;
        line-height: 0.98;
    }

    .place__body p:not(.kicker),
    .statement > p:not(.kicker),
    .gift p {
        margin: 0;
        color: rgba(47, 51, 45, 0.68);
        font-family: var(--font-body);
        font-size: 0.9rem;
        font-weight: 300;
        line-height: 1.82;
    }

    .statement {
        display: grid;
        gap: 17px;
        margin-bottom: 72px;
        padding: 38px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        text-align: center;
    }

    .statement > p:not(.kicker) {
        max-width: 570px;
        margin-inline: auto;
    }

    .statement .btn {
        justify-self: center;
    }

    .gift {
        display: grid;
        gap: 26px;
    }

    .gift > div {
        display: grid;
        gap: 14px;
    }

    .iban {
        display: grid;
        gap: 8px;
        padding-top: 18px;
        border-top: 1px solid var(--line);
    }

    .iban strong {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: clamp(1.42rem, 6vw, 2.1rem);
        font-weight: 300;
        overflow-wrap: anywhere;
    }

    @media (min-width: 760px) {
        main {
            padding: 72px clamp(28px, 5vw, 72px) 96px;
        }

        .intro {
            grid-template-columns: auto auto;
            justify-content: center;
            align-items: baseline;
            gap: clamp(24px, 4vw, 54px);
            margin-bottom: 86px;
        }

        .places {
            gap: 86px;
            margin-bottom: 104px;
        }

        .place {
            grid-template-columns: minmax(250px, 0.52fr) minmax(0, 1fr);
            align-items: center;
            gap: clamp(34px, 6vw, 86px);
        }

        .place--reverse {
            grid-template-columns: minmax(0, 1fr) minmax(250px, 0.52fr);
        }

        .place--reverse .place__image {
            grid-column: 2;
            grid-row: 1;
        }

        .place--reverse .place__body {
            grid-column: 1;
            grid-row: 1;
        }

        .place__image {
            width: min(100%, 420px);
        }

        .place__image img {
            aspect-ratio: 0.86;
        }

        .place__body {
            padding-bottom: 0;
            border-bottom: 0;
        }

        .statement {
            max-width: 720px;
            margin-bottom: 104px;
            padding: 46px 0;
        }

        .gift {
            grid-template-columns: minmax(260px, 0.82fr) minmax(0, 1fr);
            gap: clamp(32px, 7vw, 84px);
        }
    }
</style>
