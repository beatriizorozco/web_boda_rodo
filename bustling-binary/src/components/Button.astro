---
interface Props {
    url: string;
    text: string;
    variant?: "solid" | "line" | "quiet";
}

const { url, text, variant = "solid" } = Astro.props;
---

<a href={url} class={`btn btn--${variant}`} target="_blank" rel="noopener noreferrer">
    <span>{text}</span>
    <span class="btn__arrow" aria-hidden="true">&rarr;</span>
</a>

<style>
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: fit-content;
        max-width: 100%;
        min-height: 50px;
        padding: 0 28px;
        border: 1px solid transparent;
        border-radius: 999px;
        background: var(--leaf);
        color: var(--paper);
        font-family: var(--font-body);
        font-size: 0.72rem;
        font-weight: 400;
        letter-spacing: 0.09em;
        line-height: 1.35;
        text-decoration: none;
        text-transform: uppercase;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

    .btn:hover {
        background: #183324;
        color: var(--paper);
        transform: translateY(-1px);
    }

    .btn--quiet {
        border-color: rgba(36, 69, 50, 0.22);
        background: transparent;
        color: var(--leaf);
    }

    .btn--line {
        min-height: auto;
        padding: 0 0 7px;
        border: 0;
        border-bottom: 1px solid rgba(36, 69, 50, 0.28);
        border-radius: 0;
        background: transparent;
        color: var(--leaf);
        letter-spacing: 0.05em;
    }

    .btn--line:hover {
        background: transparent;
        color: #183324;
        transform: none;
    }

    .btn__arrow {
        font-family: Georgia, serif;
        font-size: 0.88rem;
        line-height: 1;
    }
</style>
