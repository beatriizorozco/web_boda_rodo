---
const image = "/casilda-rodrigo.webp";
---

<section class="hero" aria-labelledby="hero-title">
    <figure class="hero__figure">
        <img class="hero__image" src={image} alt="Casilda y Rodrigo en un jardin" />
    </figure>

    <div class="hero__caption">
        <h1 id="hero-title">
            <span>Casilda</span>
            <span>Rodrigo</span>
        </h1>
        <p>19 de septiembre de 2026</p>
    </div>
</section>

<style>
    .hero {
        display: grid;
        gap: clamp(22px, 4svh, 34px);
        min-height: calc(100svh - 58px);
        padding: 12px 18px clamp(34px, 6svh, 54px);
        background: var(--page-bg);
        color: var(--ink);
    }

    .hero__figure {
        width: min(100%, 430px);
        height: clamp(520px, 76svh, 720px);
        margin: 0 auto;
        overflow: hidden;
        border-radius: 8px;
        background: var(--wash);
        animation: imageIn 1s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hero__image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center 43%;
        filter: saturate(0.9) contrast(0.97) brightness(1.01);
    }

    .hero__caption {
        display: grid;
        gap: 12px;
        justify-items: center;
        text-align: center;
        animation: textIn 0.9s 0.12s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    h1 {
        display: grid;
        gap: 2px;
        margin: 0;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: clamp(2.9rem, 13vw, 4.35rem);
        font-weight: 300;
        letter-spacing: 0;
        line-height: 0.94;
    }

    .hero__caption p {
        margin: 0;
        color: rgba(47, 51, 45, 0.58);
        font-family: var(--font-body);
        font-size: 0.64rem;
        font-weight: 300;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    @keyframes imageIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes textIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (min-width: 760px) {
        .hero {
            min-height: calc(100svh - 68px);
            gap: clamp(24px, 4vh, 40px);
            padding: 24px clamp(28px, 5vw, 72px) clamp(40px, 6vh, 72px);
        }

        .hero__figure {
            width: min(38vw, 480px);
            height: min(74vh, 720px);
            min-height: 560px;
            border-radius: 10px;
        }

        h1 {
            font-size: clamp(3.6rem, 6vw, 5.7rem);
        }
    }

    @media (max-height: 720px) {
        .hero {
            gap: 18px;
            padding-bottom: 28px;
        }

        .hero__figure {
            height: 70svh;
            min-height: 440px;
        }

        h1 {
            font-size: clamp(2.55rem, 11vw, 3.7rem);
        }
    }
</style>
