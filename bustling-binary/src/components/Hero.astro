---
const image = "/casilda-rodrigo.webp";
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
    <img src={image} alt="Casilda y Rodrigo en un jardín" />

    <div class="hero__overlay">
        <p>19 septiembre 2026 · 13:00 h</p>
        <h1 id="hero-title">
            <span>Casilda</span>
            <em>y</em>
            <span>Rodrigo</span>
        </h1>
        <p>Guadalupe, Cáceres</p>
    </div>
</section>

<style>
    .hero {
        position: relative;
        height: calc(100svh - 65px);
        min-height: 560px;
        overflow: hidden;
        background: var(--wash);
        color: var(--paper);
        isolation: isolate;
    }

    .hero::after {
        position: absolute;
        inset: 0;
        z-index: 1;
        content: "";
        background: linear-gradient(180deg, rgba(11, 22, 16, 0.06) 0%, rgba(11, 22, 16, 0.08) 40%, rgba(11, 22, 16, 0.56) 100%);
        pointer-events: none;
    }

    .hero img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center 35%;
        filter: saturate(0.98) contrast(0.98) brightness(1.03);
        animation: photoIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hero__overlay {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 2;
        display: grid;
        justify-items: center;
        gap: 8px;
        padding: 0 24px clamp(34px, 7svh, 58px);
        text-align: center;
        text-shadow: 0 2px 18px rgba(0, 0, 0, 0.36);
        animation: textIn 0.85s 0.08s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hero__overlay p {
        margin: 0;
        font-family: var(--font-body);
        font-size: 0.72rem;
        font-weight: 400;
        letter-spacing: 0.1em;
        line-height: 1.35;
        text-transform: uppercase;
    }

    h1 {
        display: grid;
        gap: 0;
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(3rem, 13.8vw, 4.45rem);
        font-weight: 400;
        letter-spacing: -0.055em;
        line-height: 0.82;
    }

    h1 em {
        position: relative;
        display: inline-grid;
        align-items: center;
        justify-self: center;
        width: min(58vw, 220px);
        color: var(--paper);
        font-size: 0.33em;
        font-style: normal;
        letter-spacing: 0;
        line-height: 1.1;
    }

    h1 em::before,
    h1 em::after {
        height: 1px;
        background: rgba(255, 250, 240, 0.72);
        content: "";
    }

    h1 em {
        grid-template-columns: 1fr auto 1fr;
        gap: 14px;
    }

    @keyframes photoIn {
        from { opacity: 0; transform: scale(1.015); }
        to { opacity: 1; transform: scale(1); }
    }

    @keyframes textIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (min-width: 760px) {
        .hero {
            min-height: calc(100svh - 72px);
            height: auto;
            display: grid;
            justify-items: center;
            background:
                radial-gradient(circle at 20% 18%, rgba(125, 143, 99, 0.22), transparent 30%),
                linear-gradient(90deg, rgba(125, 143, 99, 0.18), var(--page-bg) 24%, var(--page-bg) 76%, rgba(125, 143, 99, 0.18));
        }

        .hero::after {
            top: 20px;
            right: auto;
            bottom: auto;
            left: 50%;
            width: min(42vw, 500px);
            height: min(calc(100svh - 128px), 700px);
            min-height: 560px;
            transform: translateX(-50%);
            background: linear-gradient(180deg, rgba(11, 22, 16, 0) 0%, rgba(11, 22, 16, 0.02) 48%, rgba(11, 22, 16, 0.34) 82%, rgba(11, 22, 16, 0) 100%);
        }

        .hero img {
            width: min(42vw, 500px);
            height: min(calc(100svh - 128px), 700px);
            min-height: 560px;
            margin-block: 20px;
            border: 10px solid var(--leaf);
            border-radius: 0;
            object-fit: cover;
            object-position: center 35%;
            box-shadow: 0 24px 70px rgba(34, 53, 41, 0.18);
        }

        .hero__overlay {
            padding-bottom: clamp(34px, 6vh, 62px);
        }

        .hero__overlay p {
            font-size: 0.78rem;
        }

        h1 {
            font-size: clamp(4.3rem, 7.4vw, 6.8rem);
        }
    }

    @media (max-height: 720px) {
        .hero {
            min-height: 520px;
        }

        .hero__overlay {
            padding-bottom: 30px;
        }

        h1 {
            font-size: clamp(2.85rem, 13vw, 4.1rem);
        }
    }
</style>
