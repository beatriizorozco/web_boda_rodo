---
const image = "/casilda-rodrigo.webp";
---

<section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
        <p class="hero__eyebrow">Guadalupe · 19 septiembre 2026</p>
        <h1 id="hero-title">Casilda <span>&</span><br />Rodrigo</h1>
    </div>

    <figure class="hero__portrait">
        <img src={image} alt="Casilda y Rodrigo en un jardín" />
        <figcaption>19 · 09 · 2026</figcaption>
    </figure>
</section>

<style>
    .hero {
        min-height: calc(100svh - 68px);
        display: grid;
        grid-template-columns: minmax(280px, 0.95fr) minmax(320px, 0.72fr);
        align-items: center;
        gap: clamp(38px, 6vw, 90px);
        padding: clamp(30px, 4vw, 58px) clamp(20px, 7vw, 104px);
        background: #f4f6f0;
        color: #293d34;
    }

    .hero__copy {
        max-width: 580px;
        animation: copyIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hero__eyebrow,
    figcaption {
        font-family: "Montserrat", sans-serif;
    }

    .hero__eyebrow {
        margin: 0 0 18px;
        color: #708275;
        font-size: 0.64rem;
        font-weight: 500;
        letter-spacing: 0.17em;
        text-transform: uppercase;
    }

    h1 {
        margin: 0;
        color: #293d34;
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(4.6rem, 8vw, 8.2rem);
        font-weight: 400;
        letter-spacing: 0;
        line-height: 0.83;
    }

    h1 span {
        color: #8da394;
        font-size: 0.62em;
        font-style: italic;
    }

    .hero__portrait {
        position: relative;
        width: min(100%, 445px);
        margin: 0;
        justify-self: end;
        aspect-ratio: 0.61;
        overflow: hidden;
        background: #e4eadf;
        animation: portraitIn 1s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hero__portrait img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center center;
        filter: saturate(0.86) contrast(0.96) brightness(1.01);
    }

    figcaption {
        position: absolute;
        right: 0;
        bottom: 0;
        padding: 12px 15px;
        background: rgba(244, 246, 240, 0.92);
        color: #557363;
        font-size: 0.58rem;
        font-weight: 500;
        letter-spacing: 0.18em;
    }

    @keyframes copyIn {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes portraitIn {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 820px) {
        .hero {
            min-height: auto;
            grid-template-columns: 1fr;
            gap: 27px;
            padding: 34px 18px 42px;
        }

        h1 {
            font-size: clamp(4.6rem, 20vw, 7rem);
        }

        .hero__portrait {
            width: min(100%, 430px);
            justify-self: center;
            aspect-ratio: 0.69;
        }

        .hero__portrait img {
            object-position: center 44%;
        }
    }
</style>
