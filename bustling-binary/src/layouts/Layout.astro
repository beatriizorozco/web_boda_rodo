        <meta name="generator" content={Astro.generator} />
        <meta name="format-detection" content="telephone=no,address=no,email=no" />
        <title>Casilda & Rodrigo</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Montserrat:wght@300;400;500&display=swap"
            rel="stylesheet"
        />
    </head>

    <body>
        <slot />

        <script is:inline>
            (function () {
                function getHashId(a) {
                    const href = a.getAttribute("href") || "";
                    const idx = href.indexOf("#");
                    if (idx === -1) return "";
                    return href.slice(idx + 1);
                }

                function scrollToSmart(id) {
                    const target = document.getElementById(id);
                    if (!target) return;

                    target.scrollIntoView({
                        behavior: "smooth",
                        block: id === "rsvp" ? "center" : "start",
                    });

                    history.pushState(null, "", "#" + id);
                }

                document.addEventListener("click", (e) => {
                    const t = e.target;
                    if (!(t instanceof Element)) return;

                    const a = t.closest('a[href^="#"], a[href^="/#"]');
                    if (!(a instanceof HTMLAnchorElement)) return;

                    const href = a.getAttribute("href") || "";
                    const id = getHashId(a);
                    if (!id) return;

                    const isHome = location.pathname === "/" || location.pathname === "";
                    if (!isHome && href.startsWith("/#")) return;

                    e.preventDefault();
                    scrollToSmart(id);
                });

                window.addEventListener("load", () => {
                    const id = (location.hash || "").replace("#", "");
                    if (id) scrollToSmart(id);
                });
            })();
        </script>
    </body>
</html>

